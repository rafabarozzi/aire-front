# Production is fail-closed. Use AIRE_MODE=demo only with synthetic data.
AIRE_MODE=live
AIRE_DOMAIN=aire.northeia.com
ACME_EMAIL=replace-with-your-email
AIRE_APP_ORIGIN=https://aire.northeia.com
AIRE_DATA_DIR=/data
# Generate: openssl rand -hex 32
AIRE_SESSION_SECRET=
# Optional independent encryption secret (32+ chars), set before saving tokens.
# Otherwise AIRE_SESSION_SECRET is used. Changing the active key requires re-entering credentials.
AIRE_CREDENTIAL_SECRET=
AIRE_GOOGLE_CLIENT_ID=
AIRE_GOOGLE_CLIENT_SECRET=
AIRE_MICROSOFT_TENANT_ID=
AIRE_MICROSOFT_CLIENT_ID=
AIRE_MICROSOFT_CLIENT_SECRET=
# Shared multitenant customer app; separate from operator credentials above.
AIRE_CUSTOMER_MICROSOFT_CLIENT_ID=
AIRE_CUSTOMER_MICROSOFT_CLIENT_SECRET=
# Copy a compact JSON array based on docs/tenants.example.json. Never expose as NEXT_PUBLIC_*.
AIRE_TENANTS_JSON=[]
NORTHEIA_GITHUB_TOKEN=
NORTHEIA_ENGINE_URL=
NORTHEIA_ENGINE_TOKEN=
# Invitations: verified sender domain in Resend. Server-only; never NEXT_PUBLIC_*.
AIRE_RESEND_API_KEY=
AIRE_EMAIL_FROM=
