# Production is fail-closed. Use AIRE_MODE=demo only with synthetic data.
AIRE_MODE=live
AIRE_DOMAIN=aire.northeia.com
ACME_EMAIL=replace-with-your-email
AIRE_APP_ORIGIN=https://aire.northeia.com
AIRE_DATA_DIR=/data
# Generate: openssl rand -hex 32
AIRE_SESSION_SECRET=
AIRE_GOOGLE_CLIENT_ID=
AIRE_GOOGLE_CLIENT_SECRET=
AIRE_MICROSOFT_TENANT_ID=
AIRE_MICROSOFT_CLIENT_ID=
AIRE_MICROSOFT_CLIENT_SECRET=
# Copy a compact JSON array based on docs/tenants.example.json. Never expose as NEXT_PUBLIC_*.
AIRE_TENANTS_JSON=[]
NORTHEIA_GITHUB_TOKEN=
NORTHEIA_ENGINE_URL=
NORTHEIA_ENGINE_TOKEN=
